<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>AntigravityHUD</AssemblyName>
    <Product>Antigravity HUD</Product>
    <AssemblyTitle>Antigravity HUD</AssemblyTitle>
    <Description>Lightweight Apple-style Windows System Tray and Floating HUD for Google Antigravity quotas.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="AgyUsageTray.Tests\**" />
    <EmbeddedResource Remove="AgyUsageTray.Tests\**" />
    <None Remove="AgyUsageTray.Tests\**" />
    <None Update="app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>